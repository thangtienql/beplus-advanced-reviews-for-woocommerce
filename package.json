{
	"name": "beplus-advanced-reviews-for-woocommerce",
	"version": "1.0.0",
	"description": "Modern WooCommerce product reviews with image support, star distribution, AJAX filtering, and load more.",
	"private": true,
	"scripts": {
		"build:css": "sass --no-source-map --style=compressed blocks/advanced-review/style.scss:blocks/advanced-review/style.css admin/css/admin.scss:admin/css/admin.css",
		"build": "npm run build:css && node esbuild.config.mjs",
		"watch:css": "sass --watch blocks/advanced-review/style.scss:blocks/advanced-review/style.css admin/css/admin.scss:admin/css/admin.css",
		"watch": "node esbuild.config.mjs --watch",
		"composer:install": "php composer.phar install --no-dev 2>/dev/null || composer install --no-dev 2>/dev/null || echo 'Composer not available'",
		"build:package": "node ./scripts/build-package.mjs",
		"prepare": "husky",
		"ensure:composer": "composer install",
		"typecheck": "tsc --noEmit",
		"lint:php:all": "php -d memory_limit=2G vendor/bin/phpstan analyze --memory-limit 2G",
		"precommit": "npm run build:css && npm run typecheck && npm run lint:php:all",
		"prepush": "npm run ensure:composer && npm run typecheck && npm run lint:php:all && npm run build"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^15.23.0",
		"@wordpress/blocks": "^15.23.0",
		"@wordpress/components": "^36.1.0",
		"@wordpress/element": "^8.2.0",
		"@wordpress/i18n": "^6.23.0",
		"@wordpress/scripts": "^32.5.1",
		"archiver": "^8.0.0",
		"esbuild": "^0.19.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"sass": "^1.101.0"
	},
	"packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
