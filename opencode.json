{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "Document Plugin.md"],
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git#v6.2.0"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
